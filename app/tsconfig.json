{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    // tools/*.mjs (errors.mjs, server.mjs) são importados pelo código TS da tool:
    // aceita JS sem checar o JS em si, só para ter os tipos dos exports
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "tools"]
}
