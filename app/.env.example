# =====================================================================
# Tania_Assistente — variáveis de ambiente (template público)
#
#   cp app/.env.example app/.env      e preencha os valores reais.
#
# Um arquivo só para tudo: Node (server.mjs, Vite), Rust (cargo run), o
# docker-compose.yml da raiz e o deploy (app/build.yml) leem este app/.env.
# NUNCA commite o app/.env (está no .gitignore). Referência: SPEC.md §8.1.
#
# Legenda: [obrigatório] sem ele algo não sobe | [opcional] tem default.
# O docker-compose.yml da raiz NÃO precisa deste arquivo: login, banco e bucket
# têm default local lá. Se existir, entram só as integrações (WhatsApp, LLM, BRAPI).
# As integrações (WhatsApp, LLM, token do ClickUp, rate limit) também podem ser editadas em ⚙ Configurações:
# o valor salvo no banco vence o deste arquivo e vale depois de "Aplicar e reiniciar".
# =====================================================================

# ---------- Login do site ----------
# Node legado (produção atual): usuario:senha. Sem ele só o localhost entra (o resto recebe 503).
# O backend Rust NÃO usa: lá o login é por usuário no Postgres (DATABASE_URL).
VAULT_AUTH='usuario:senha'
# [opcional] backend Rust: admin criado na subida só se não existir nenhum usuário. Não use em produção.
# TANIA_BOOTSTRAP_ADMIN=admin:troque-esta-senha
# [obrigatório com Rust na frente do Node] segredo do header Rust -> Node (mesmo valor nos dois)
# LEGACY_PROXY_SECRET=um-segredo-longo-e-aleatorio
# [obrigatório para salvar segredos em ⚙ Configurações] 32 bytes em base64 (Rust e Node): head -c 32 /dev/urandom | base64
# Perder esta chave = os segredos salvos no banco ficam ilegíveis (cadastre de novo).
# TANIA_CONFIG_KEY=

# ---------- Storage do vault (bucket S3: RustFS em produção) ----------
# [obrigatório] rustfs = bucket S3 compatível (RustFS; minio e s3 também valem) | local = pasta no disco (só dev)
# Os nomes antigos MINIO_* ainda são aceitos no lugar de RUSTFS_* (troque quando puder).
VAULT_STORAGE=rustfs
# Endpoint que o servidor usa para falar com o bucket (rede interna).
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_USE_SSL=false
# [opcional] Endpoint que o NAVEGADOR usa nos links assinados dos anexos. Vazio = RUSTFS_ENDPOINT.
RUSTFS_PUBLIC_ENDPOINT=https://s3.seu-dominio.com.br
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=SEU_ACCESS_KEY
RUSTFS_SECRET_KEY=SEU_SECRET_KEY
RUSTFS_BUCKET=tania-vault
# [opcional] validade dos links assinados, em segundos (padrão 300)
# RUSTFS_PRESIGN_TTL=300

# [opcional] só com VAULT_STORAGE=local: pasta do vault (padrão: raiz do repositório)
# VAULT_ROOT=/caminho/para/o/vault

# ---------- Postgres (financeiro, lembretes, investimentos) ----------
# [obrigatório para essas telas] postgres://usuario:senha@host:porta/banco. Sem ele, só o vault funciona.
# Alternativa: deixe vazio e use as variáveis padrão PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE.
DATABASE_URL=postgres://tania:SENHA@postgres.seu-servidor:5432/tania
# [opcional] 1 = conexão com TLS (sem validar o certificado)
# PG_SSL=0
# [opcional] conexões no pool (padrão 10)
# PG_POOL_MAX=10

# ---------- WhatsApp (Evolution API) ----------
EVOLUTION_URL=http://evolution.seu-servidor:8080
EVOLUTION_API_KEY=SEU_APIKEY
EVOLUTION_INSTANCE=tania
# [opcional] token próprio da instância (o apikey que chega no webhook). Vazio = EVOLUTION_API_KEY.
EVOLUTION_INSTANCE_TOKEN=
# [opcional] 1 = não envia nada, só loga o que seria enviado
EVOLUTION_DRY_RUN=0
# [obrigatório para o WhatsApp] números permitidos, só dígitos com DDI+DDD, separados por vírgula.
# Lista vazia = ninguém é atendido.
WHATSAPP_ALLOWED_NUMBERS=5511999999999,5511888888888

# ---------- Investimentos ----------
# [opcional] token da brapi.dev. Sem ele a tela abre, mas cotações e agentes ficam parados.
BRAPI_TOKEN=

# ---------- Agente LLM e ClickUp ----------
# Chaves lidas pelo nome configurado em apiKeyEnv do agent.config.json (preencha só as que usar).
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# [opcional] token do ClickUp (pk_…); vence o do clickup.config.json. Também editável em ⚙ Configurações.
# CLICKUP_TOKEN=
# [opcional] caminhos dos arquivos de config (padrão: app/agent.config.json e app/clickup.config.json)
# AGENT_CONFIG=/caminho/agent.config.json
# CLICKUP_CONFIG=/caminho/clickup.config.json

# ---------- Servidor ----------
# [opcional] porta. Fora do Docker: Rust 3100 e Node 3101. Os compose já definem.
# PORT=3100
# [opcional] backend Rust: URL do Node legado (rotas ainda não portadas)
# LEGACY_UPSTREAM=http://127.0.0.1:3101
# [opcional] limite de requisições por IP na /api, por janela (padrão 300 a cada 60000 ms)
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
